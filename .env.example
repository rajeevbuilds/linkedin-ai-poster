# Copy this file to .env and fill in real values.
# .env is git-ignored — it will never be pushed to GitHub.

# --- LinkedIn Developer App (create at https://www.linkedin.com/developers/apps) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/callback

# Obtained by running: python -m src.oauth_helper
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:XXXXXXXX

# --- Optional: used to draft/polish the post text with Claude ---
# Get one at https://console.anthropic.com
# Leave blank to use a simple template instead.
ANTHROPIC_API_KEY=

# --- Optional: extra topic sources beyond Hacker News ---
# Hacker News is always used as the trusted baseline; these two are
# best-effort extras. Leave either blank to skip that source entirely.
# GNews: https://gnews.io  |  NewsAPI: https://newsapi.org
GNEWS_API_KEY=
NEWSAPI_API_KEY=

# --- Behavior ---
# How many hours back to look for "hot" AI stories
TOPIC_LOOKBACK_HOURS=24
# Set to "true" to actually publish; "false" prints the draft instead (safe default)
DRY_RUN=true
